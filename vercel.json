{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/landing",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/landing.html",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/app",
      "destination": "/frontend/app.html"
    },
    {
      "source": "/app.html",
      "destination": "/frontend/app.html"
    },
    {
      "source": "/src/(.*)",
      "destination": "/frontend/src/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    }
  ]
}
